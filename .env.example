# SecureLLM Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Application Settings
APP_NAME=SecureLLM
APP_ENV=development
PORT=8080
HOST=0.0.0.0
DEBUG=True

# LLM Provider Configuration
# Supported providers: "gemini", "mock", "ollama", "openai"
LLM_PROVIDER=gemini

# Google Gemini Settings (when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Ollama Settings (when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI / Compatible API Settings (when LLM_PROVIDER=openai)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# API Authentication (leave unset to auto-generate via secrets.token_urlsafe(48) on startup)
# API_AUTH_TOKEN=your_generated_bearer_token_here

# Canary Token (leave unset to auto-generate a per-deployment token on startup; never commit or publish)
# SYSTEM_CANARY_TOKEN=your_per_deployment_canary_token_here

# Security & Guardrail Thresholds
FAIL_CLOSED=True
REQUIRE_NEMO_RAILS=False
ENABLE_INPUT_VALIDATION=True
ENABLE_OUTPUT_VALIDATION=True
ENABLE_CANARY_CHECK=True
ENABLE_PII_SCRUBBING=True
ENABLE_AUDIT_LOGGING=True
MAX_INPUT_LENGTH=4096

# Audit Log Path
AUDIT_LOG_FILE=logs/security_audit.jsonl
